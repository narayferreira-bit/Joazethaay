<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Cinzel+Decorative:wght@400;700&display=swap" rel="stylesheet">

<style>

body{
margin:0;
font-family: Arial;
background:url('https://i.ibb.co/zWGf65FK/file-00000000771071f59cc5b2ff3766088e.png') no-repeat center;
background-size:cover;
display:flex;
justify-content:center;
align-items:center;
height:100vh;

/* 🔥 reduz gesto lateral */
overscroll-behavior-x:none;
}

.container{
background:rgba(255,255,255,0.95);
padding:20px;
border-radius:20px;
width:90%;
max-width:340px;
text-align:center;
}

.titulo{
width:240px;
margin-bottom:20px;
pointer-events:none;
}

input{
width:100%;
padding:12px;
border-radius:12px;
border:1px solid #ddd;
margin-bottom:10px;
}

button{
width:100%;
padding:12px;
background:#5c6f4f;
color:white;
border:none;
border-radius:12px;
font-weight:600;
font-family:'Cinzel Decorative', serif;
letter-spacing:1px;
transition:0.3s;
}

button:active{
transform:scale(0.97);
}

.loading{
opacity:0.6;
pointer-events:none;
}

select{
width:100%;
padding:12px;
border-radius:12px;
border:1px solid #ddd;
margin:10px 0;
}

.lista{
margin-top:10px;
}

.nome-item{
padding:10px;
border-radius:10px;
background:#eee;
margin-top:5px;
cursor:pointer;
font-family:'Cinzel', serif;
}

.resultado{
margin-top:10px;
font-family:'Cinzel', serif;
font-size:16px;
letter-spacing:1px;
}

.pix-box{
margin-top:35px;
padding:15px;
background:#f3f3f3;
border-radius:15px;
}

.pix-title{
font-family:'Cinzel Decorative', serif;
margin-bottom:15px;
font-size:18px;
letter-spacing:1px;
}

/* TOAST */
.toast{
position:fixed;
top:50%;
left:50%;
transform:translate(-50%,-50%) scale(0.9);
background:rgba(255,255,255,0.95);
backdrop-filter: blur(10px);
padding:20px;
border-radius:20px;
font-family:'Cinzel', serif;
text-align:center;
box-shadow:0 10px 30px rgba(0,0,0,0.2);
opacity:0;
transition:0.3s;
z-index:9999;
}

.toast.show{
opacity:1;
transform:translate(-50%,-50%) scale(1);
}

</style>
</head>

<body>

<div class="container">

<img class="titulo" src="https://i.ibb.co/Vc3YTkHy/Design-sem-nome-20260428-232736-0000.png">

<input id="nome" placeholder="Digite seu nome">
<button id="btnBuscar" onclick="buscar()">Buscar</button>

<div id="lista" class="lista"></div>

<div id="resultado" class="resultado"></div>

<div id="confirmacao" style="display:none;">
<p>Você irá comparecer?</p>

<select id="resposta">
<option>Sim, irei</option>
<option>Não poderei ir</option>
</select>

<button id="btnConfirmar" onclick="confirmar()">Confirmar presença</button>
</div>

<div class="pix-box">
<div class="pix-title">💚 Presenteie-nos</div>
<button onclick="copiarPix()">Copiar chave Pix</button>
</div>

</div>

<div id="toast" class="toast"></div>

<script>

const url="https://script.google.com/macros/s/AKfycbwx4FDawR9MDDEhVfhpo2CbiOrFHEhXGZg7EwtfRh0On02ns9LttO5Ix07Cm_Mqsd84/exec";

// TOAST
function toast(msg){
let t=document.getElementById("toast");
t.innerHTML=msg;
t.classList.add("show");
setTimeout(()=>t.classList.remove("show"),2500);
}

// BUSCAR
function buscar(){

let nome=document.getElementById("nome").value;
let btn=document.getElementById("btnBuscar");

btn.classList.add("loading");
btn.innerText="Buscando...";

fetch(url+"?nome="+encodeURIComponent(nome))
.then(r=>r.json())
.then(d=>{

btn.classList.remove("loading");
btn.innerText="Buscar";

let lista=document.getElementById("lista");
lista.innerHTML="";

if(!d.encontrado){
toast("Nome não encontrado ❌");
return;
}

let div=document.createElement("div");
div.className="nome-item";
div.innerText=d.nome;

div.onclick=function(){
document.getElementById("nome").value=d.nome;
document.getElementById("resultado").innerText=d.nome;
document.getElementById("confirmacao").style.display="block";
lista.innerHTML="";
};

lista.appendChild(div);

});
}

// CONFIRMAR (POST REAL)
function confirmar(){

let nome=document.getElementById("nome").value;
let status=document.getElementById("resposta").value;
let btn=document.getElementById("btnConfirmar");

btn.classList.add("loading");
btn.innerText="Confirmando...";

fetch(url,{
method:"POST",
body: JSON.stringify({
nome: nome,
status: status
})
})
.then(r=>r.json())
.then(d=>{

btn.classList.remove("loading");
btn.innerText="Confirmar presença";

if(d.sucesso){
toast("Obrigada pelo carinho 💚<br><small>Nos vemos em breve</small>");
}else{
toast("Erro ao confirmar ❌");
}

})
.catch(()=>{
btn.classList.remove("loading");
btn.innerText="Confirmar presença";
toast("Erro ao confirmar ❌");
});
}

// PIX
function copiarPix(){
navigator.clipboard.writeText("02965634207");
toast("Obrigada pelo carinho 💚");
}

</script>

</body>
</html>
